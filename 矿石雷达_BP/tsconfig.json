{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020","dom"],
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["server","server-ui"],
    "typeRoots": ["./types/@minecraft"],
    "outDir": "./scripts",
    "rootDir": "./src",
    "rootDirs": ["./src", "./types"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "scripts"]
}